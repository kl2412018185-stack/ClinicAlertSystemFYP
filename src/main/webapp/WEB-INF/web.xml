<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Clinic Alert Smart Medicine Management System</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Medicine Servlet -->
    <servlet>
        <servlet-name>MedicineServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.MedicineServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MedicineServlet</servlet-name>
        <url-pattern>/medicine</url-pattern>
        <url-pattern>/medicine/add</url-pattern>
        <url-pattern>/medicine/edit</url-pattern>
        <url-pattern>/medicine/delete</url-pattern>
    </servlet-mapping>

    <!-- Stock In Servlet -->
    <servlet>
        <servlet-name>StockInServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.StockInServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StockInServlet</servlet-name>
        <url-pattern>/stockin</url-pattern>
    </servlet-mapping>

    <!-- Stock Out Servlet -->
    <servlet>
        <servlet-name>StockOutServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.StockOutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StockOutServlet</servlet-name>
        <url-pattern>/stockout</url-pattern>
    </servlet-mapping>

    <!-- Low Stock Servlet -->
    <servlet>
        <servlet-name>LowStockServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.LowStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LowStockServlet</servlet-name>
        <url-pattern>/lowstock</url-pattern>
    </servlet-mapping>

    <!-- Expiry Servlet -->
    <servlet>
        <servlet-name>ExpiryServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.ExpiryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExpiryServlet</servlet-name>
        <url-pattern>/expiry</url-pattern>
        <url-pattern>/expirydate</url-pattern>
    </servlet-mapping>

    <!-- Reports Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports</url-pattern>
        <url-pattern>/report</url-pattern>
    </servlet-mapping>

    <!-- Profile Servlet -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Change Password Servlet -->
    <servlet>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.ChangePasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChangePasswordServlet</servlet-name>
        <url-pattern>/changepassword</url-pattern>
    </servlet-mapping>

    <!-- User Management Servlet -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.clinicalert.controller.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/usermanagement</url-pattern>
        <url-pattern>/users/add</url-pattern>
        <url-pattern>/users/edit</url-pattern>
        <url-pattern>/users/toggle</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
